pipeline {
  // Runs directly on the Jenkins controller/agent node itself - no Docker
  // agent, no bind-mounted socket, no root-owned files. Requires Maven and
  // Docker to be installed locally on this machine, and the jenkins user to
  // be a member of the 'docker' group (see notes below).
  agent any

  environment {
    SONAR_URL          = "http://13.127.125.106:9000/"
    DOCKER_IMAGE       = "imriyaz17/general:${BUILD_NUMBER}"
    GIT_REPO_NAME      = "java_app_two"
    GIT_USER_NAME      = "RiyazAfz"
  }

  stages {
    stage('Checkout') {
      steps {
        sh 'echo passed'
        git branch: 'main', url: 'https://github.com/RiyazAfz/java_app_two.git'
      }
    }

    stage('Build and Test') {
    steps {
        dir('spring-boot-app') {
            sh 'ls -ltr'
            sh 'mvn clean package'
        }
    }
}

   stage('Static Code Analysis') {
    steps {
        dir('spring-boot-app') {
            withCredentials([string(credentialsId: 'sonarcred', variable: 'SONAR_AUTH_TOKEN')]) {
                sh '''
                    mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                      -Dsonar.login=$SONAR_AUTH_TOKEN \
                      -Dsonar.host.url=$SONAR_URL
                '''
            }
        }
    }
}

    stage('Build and Push Docker Image') {
      steps {
          dir('spring-boot-app') {
        withCredentials([usernamePassword(credentialsId: 'dockercred', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
          sh '''
            docker build -t ${DOCKER_IMAGE} .
            echo "${DOCKER_PASS}" | docker login -u "${DOCKER_USER}" --password-stdin
            docker push ${DOCKER_IMAGE}
          '''
        }
      }
    }
}

    stage('Update Deployment File') {
      steps {
        withCredentials([string(credentialsId: 'gitcred', variable: 'GITHUB_TOKEN')]) {
          sh '''
            git config user.email "imriyaz17@gmail.com"
            git config user.name "Riyaz"
            sed -i -E 's|(image: imriyaz17/general:)[^[:space:]]+|\\1${BUILD_NUMBER}|' \
#            sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" spring-boot-app-manifests/deployment.yml
            git add spring-boot-app-manifests/deployment.yml
            git commit -m "Update deployment image to version ${BUILD_NUMBER}"
            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
          '''
        }
      }
    }
  }
}
